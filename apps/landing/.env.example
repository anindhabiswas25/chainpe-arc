# ChainPe landing + docs site (apps/landing). Everything is optional.

# Public URL of the dashboard (apps/dashboard). When set, the landing page links
# to its /network, /register and /vault pages. Leave unset if it isn't deployed:
# the links are hidden rather than pointing at a guess.
# NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.example.com

# Public ChainPe repository; GitHub links are hidden while this is unset.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo
