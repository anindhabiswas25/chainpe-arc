# ChainPe dashboard. Arc Testnet (chain 5042002) is the only supported network.
NEXT_PUBLIC_NETWORK=arc-testnet

# Optional Arc RPC override (browser reads balances/logs/receipts from it; it's
# also added to the CSP connect-src automatically).
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Contract addresses on Arc Testnet (docs/DEPLOYMENTS.md). The deployed
# addresses below are the built-in defaults; set these only to override them.
# NEXT_PUBLIC_CHAINPE_REGISTRY_ADDRESS=0x79c7a22993A40A3c88355b737e6F608c6610c395
# NEXT_PUBLIC_POLICY_VAULT_ADDRESS=0xcD5f994A57d7846c3DdFb471cBf4EdA0Bcf43a81
# NEXT_PUBLIC_CHAINPE_TIMELOCK_ADDRESS=0x5071794F30C32604Be115c00Ed041c403fB2f302
# ERC-8004: Arc's canonical registries.
# NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# NEXT_PUBLIC_ERC8004_VALIDATION_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# Server-side only (never sent to the browser):
# Indexer for /marketplace and /services/[id] (services/chainpe-indexer). Optional:
# when unset or unreachable those pages read the ChainPeRegistry on-chain instead.
# INDEXER_URL=http://localhost:4600
# Your self-hosted facilitator (services/chainpe-facilitator); /network shows its health.
# CHAINPE_FACILITATOR_URL=http://localhost:4500

# Where /docs redirects (the fumadocs site in apps/landing). Set this to your
# deployed docs URL; the default below was not reachable when last checked.
# DOCS_URL=https://chainpe.xyz/docs

# Public ChainPe repository; GitHub links are hidden while this is unset.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo
