{
  "name": "@chainpearc/cli",
  "version": "3.0.0",
  "description": "ChainPe Provider CLI — Monetize any API with x402 micropayments on Arc Testnet",
  "type": "module",
  "bin": {
    "chainpe": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "ChainPe",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "proxy",
    "micropayments",
    "pay-per-request",
    "http-402",
    "blockchain",
    "usdc",
    "api-monetization",
    "reverse-proxy",
    "ai-agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@chainpearc/sdk": "^0.3.0",
    "@clack/prompts": "^0.9.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "gradient-string": "^3.0.0",
    "http-proxy-middleware": "^3.0.5",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "viem": "^2.48.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
