# ChainPe indexer — gitignored .env (never commit secrets)

# Postgres (Railway provides DATABASE_URL when you add a Postgres plugin).
DATABASE_URL=postgres://user:pass@host:5432/chainpe

# Network + contracts. Arc Testnet is the only supported network.
NETWORK=arc-testnet
# ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional overrides. Defaults: the deployed ChainPeRegistry
# (contracts/deployments/arc-testnet.json) and Arc's canonical ERC-8004
# ReputationRegistry 0x8004B663056A597Dffe9eCcC1965A193B7388713.
# CHAINPE_REGISTRY_ADDRESS=
# ERC8004_REPUTATION_REGISTRY=

# Indexing. START_BLOCK defaults to the ChainPeRegistry deployment block.
# START_BLOCK=
POLL_INTERVAL_MS=5000
LOG_CHUNK=2000

# HTTP port (Railway injects PORT automatically).
PORT=4600
