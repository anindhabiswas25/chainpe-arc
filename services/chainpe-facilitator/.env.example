# ChainPe Facilitator — copy to .env (gitignored). Never commit real keys.

# Gas-paying key that submits settlements. NON-CUSTODIAL: it only pays gas and
# relays the payer's signed authorization; it never holds user funds.
# Fund it with testnet USDC (gas on Arc) from https://faucet.circle.com.
FACILITATOR_PRIVATE_KEY=0xYOUR_GAS_KEY

# Optional RPC override (default https://rpc.testnet.arc.io)
# ARC_RPC_URL=https://rpc.testnet.arc.io

# Port (Railway injects PORT automatically)
PORT=4500

# CORS allowlist for browser callers (comma-separated). Empty = deny browsers.
# ALLOWED_ORIGINS=https://dashboard.example.com

# /health reports "degraded" below this gas balance (USDC)
# LOW_GAS_THRESHOLD_USDC=0.5
