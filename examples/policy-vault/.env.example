# PolicyVault. Defaults to the live Arc Testnet vault; set this only for your own
# deployment (cd contracts && npm run deploy:policyvault).
# POLICY_VAULT_ADDRESS=0xcD5f994A57d7846c3DdFb471cBf4EdA0Bcf43a81

# Three DISTINCT keys for the three roles. USDC is the gas token on Arc.
OWNER_KEY=0x...      # funds the vault + sets policy (needs USDC, which also pays gas)
SESSION_KEY=0x...    # the agent's session signer (needs nothing — pays no gas)
RELAYER_KEY=0x...    # submits spends (needs USDC for gas)

# Where spends go (e.g. a provider payTo).
RECIPIENT=0x...

# Network + token (Arc Testnet is the only supported network).
CHAINPE_NETWORK=arc-testnet
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ARC_RPC_URL=https://rpc.testnet.arc.io
