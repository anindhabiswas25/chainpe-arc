# ─── Buyer (orchestrator) ─────────────────────────────────────────────────────
# Wallet that pays all seller agents. Needs testnet USDC (USDC is also the gas
# token on Arc). Get test USDC: https://faucet.circle.com  (select Arc Testnet)
CHAINPE_PRIVATE_KEY=0x...

# ─── Demo sellers ─────────────────────────────────────────────────────────────
# Each needs its OWN wallet — ERC-8004 blocks self-feedback.
# Generate fresh wallets: node gen-wallets.mjs
RESEARCH_PAYTO=0x...
RESEARCH_PAYTO_KEY=0x...
DIGEST_PAYTO=0x...
DIGEST_PAYTO_KEY=0x...

# ─── Shared ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Settlement facilitator. Preferred: your self-hosted facilitator
# (services/chainpe-facilitator — see the "Self-hosting the facilitator" docs).
CHAINPE_FACILITATOR_URL=http://localhost:4500
# Alternative for local dev: run one in-process in each seller proxy with a gas
# key funded with USDC (USDC is the gas token on Arc).
# CHAINPE_FACILITATOR_KEY=0x...

# Network + contracts. Addresses default to the live Arc Testnet deployment and
# Arc's canonical ERC-8004 registries; override only if needed.
CHAINPE_NETWORK=arc-testnet
# ARC_RPC_URL=https://rpc.testnet.arc.io
# CHAINPE_REGISTRY_ADDRESS=0x79c7a22993A40A3c88355b737e6F608c6610c395
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ─── Ports / pricing (optional) ───────────────────────────────────────────────
RESEARCH_PROXY_PORT=4501
RESEARCH_BACKEND_PORT=5101
RESEARCH_PRICE=0.01
DIGEST_PROXY_PORT=4502
DIGEST_BACKEND_PORT=5102
DIGEST_PRICE=0.01

# ─── Model overrides (optional) ───────────────────────────────────────────────
# RESEARCH_MODEL=claude-sonnet-4-6
# DIGEST_MODEL=claude-haiku-4-5-20251001
