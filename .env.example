# ChainPe Environment Variables (Arc Testnet)
# Copy to .env and fill in your values.  NEVER commit your real .env.
#
# .env is gitignored. Secrets (private keys) live ONLY here, never in source.

# ============================================================================
# CONTRACT DEPLOYMENT (packages: contracts/ — Hardhat)
# ============================================================================

# Funded deployer private key (0x-prefixed, 64 hex chars). Used by hardhat.config.ts
# to sign deployments to Arc Testnet. KEEP SECRET.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# RPC override (optional — the public Arc Testnet RPC is used if unset)
ARC_RPC_URL=https://rpc.testnet.arc.io

# Registry constructor params (optional — deploy.ts has defaults)
# FEE_TOKEN_ADDRESS defaults to the Arc Testnet USDC interface:
#   0x3600000000000000000000000000000000000000
FEE_TOKEN_ADDRESS=
FEE_RECIPIENT=                 # treasury for registration fees (defaults to deployer)
REGISTRATION_FEE_USDC=1.0      # human-readable USDC fee per register/update
IDENTITY_REGISTRY=             # ERC-8004 Identity Registry (defaults to Arc's canonical registry)
OWNER_ADDRESS=                 # owner of the upgradeable contracts (Safe/timelock; defaults to deployer)

# ============================================================================
# PROVIDER CONFIGURATION (chainpe CLI)
# ============================================================================

# Your wallet address (0x...) that receives payments.
CHAINPE_WALLET_ADDRESS=0xYOUR_ADDRESS

# Backend API URL to proxy
CHAINPE_TARGET=http://localhost:3000

# Price per request (in USDC)
CHAINPE_PRICE=0.01

# Payment token: USDC
CHAINPE_TOKEN=USDC

# Service metadata
CHAINPE_SERVICE_NAME=My AI Service
CHAINPE_SERVICE_DESCRIPTION=An AI-powered service
CHAINPE_TAGS=ai,nlp,research

# Proxy port
CHAINPE_PORT=4402

# Network: arc-testnet (the only supported network)
CHAINPE_NETWORK=arc-testnet

# Contract overrides. Leave blank to use the live Arc Testnet deployment
# (exported as ARC_TESTNET_CONTRACTS from @chainpearc/sdk/arc):
#   ChainPeRegistry 0x79c7a22993A40A3c88355b737e6F608c6610c395
#   PolicyVault     0xcD5f994A57d7846c3DdFb471cBf4EdA0Bcf43a81
CHAINPE_REGISTRY_ADDRESS=
POLICY_VAULT_ADDRESS=

# x402 facilitator the provider proxy settles through (self-hosted:
# services/chainpe-facilitator). Local default port is 4500.
CHAINPE_FACILITATOR_URL=http://localhost:4500

# Log level: verbose, normal, quiet
CHAINPE_LOG_LEVEL=normal

# ============================================================================
# CONSUMER / AGENT CONFIGURATION (chainpe-wallet MCP, chainpe-agent)
# ============================================================================

# Agent wallet private key (0x...). Used to sign x402 USDC payments.
# In the MCP extension this is stored in the OS keychain, not on disk.
CHAINPE_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY

# Network: arc-testnet (the only supported network)
NETWORK=arc-testnet

# Budget limits (USDC)
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00

# ERC-8004 registry overrides. Leave blank to use Arc's canonical registries:
#   Identity   0x8004A818BFB912233c491871b3d84c89A494BD9e
#   Reputation 0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=

# LLM (chainpe-agent)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o
AGENT_LLM_API_KEY=your-api-key

# ============================================================================
# ARC TESTNET RESOURCES
# ============================================================================
# Chain id:       5042002
# USDC faucet:    https://faucet.circle.com  (select Arc Testnet) — USDC is also the gas token
# Explorer:       https://explorer.testnet.arc.io  (testnet.arcscan.app redirects here)
# RPC:            https://rpc.testnet.arc.io  (override with ARC_RPC_URL)
# x402 network:   eip155:5042002

# ============================================================================
# FACILITATOR (self-hosted: services/chainpe-facilitator)
# ============================================================================
# The service itself reads FACILITATOR_PRIVATE_KEY (a dedicated gas key holding a
# little USDC); see services/chainpe-facilitator/.env.example. Provider proxies
# reach it through CHAINPE_FACILITATOR_URL, set above.
