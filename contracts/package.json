{
  "name": "@chainpearc/contracts",
  "version": "2.0.0",
  "description": "ChainPe on-chain registry smart contracts for Arc Testnet (Solidity)",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "deploy:erc8004": "hardhat run scripts/deploy-erc8004.ts --network arcTestnet",
    "deploy:arc-testnet": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:policyvault": "hardhat run scripts/deploy-policyvault.ts --network arcTestnet",
    "transfer-ownership": "hardhat run scripts/transfer-ownership.ts --network arcTestnet",
    "register-demo": "hardhat run scripts/register-demo-services.ts --network arcTestnet",
    "check-keys": "ts-node scripts/check-keys.ts",
    "lint:sol": "npx solhint 'contracts/**/*.sol'",
    "verify": "hardhat run scripts/verify.ts --network arcTestnet",
    "node": "hardhat node",
    "record:erc8004": "hardhat run scripts/record-erc8004.ts --network arcTestnet",
    "preflight": "hardhat run scripts/preflight.ts --network arcTestnet",
    "postcheck": "hardhat run scripts/postcheck.ts --network arcTestnet",
    "deploy:timelock": "hardhat run scripts/deploy-timelock.ts --network arcTestnet",
    "verify:blockscout": "ts-node scripts/verify-blockscout.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
